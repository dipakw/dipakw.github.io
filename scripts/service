#!/usr/bin/env bash
set -euo pipefail

# Always read from terminal (even if script is piped)
input() {
  local prompt=$1
  local var
  read -rp "$prompt" var </dev/tty
  echo "$var"
}

# Prompt for inputs
SERVICE_NAME=$(input "Service name (no spaces): ")
DESCRIPTION=$(input "Description: ")
EXEC_PATH=$(input "Executable (full path): ")
WORK_DIR=$(input "Working directory: ")
RUN_USER=$(input "User to run as: ")
RUN_GROUP=$(input "Group to run as: ")

# Define target path
SERVICE_FILE="/etc/systemd/system/${SERVICE_NAME}.service"

# Confirm before writing
echo "---------------------------------------------------"
echo "Creating systemd service at: $SERVICE_FILE"
CONFIRM=$(input "Proceed? [y/N]: ")
if [[ "$CONFIRM" != [yY] ]]; then
  echo "Aborted."
  exit 1
fi

# Write the service file
sudo tee "$SERVICE_FILE" > /dev/null <<EOF
[Unit]
Description=${DESCRIPTION}
After=network.target

[Service]
ExecStart=${EXEC_PATH}
WorkingDirectory=${WORK_DIR}
Restart=always
RestartSec=5
User=${RUN_USER}
Group=${RUN_GROUP}
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF

sudo systemctl daemon-reload
echo "---------------------------------------------------"
echo "✅ Service ${SERVICE_NAME} created."
echo "---------------------------------------------------"
CONFIRM=$(input "Would you like to enable? [y/N]: ")

if [[ "$CONFIRM" == [yY] ]]; then
  sudo systemctl enable "$SERVICE_NAME"
fi

CONFIRM=$(input "Would you like to start? [y/N]: ")

if [[ "$CONFIRM" == [yY] ]]; then
  sudo systemctl start "$SERVICE_NAME"
fi

echo "---------------------------------------------------"
echo "Examples:"
echo "---------------------------------------------------"
echo "sudo systemctl start ${SERVICE_NAME}"
echo "sudo systemctl status ${SERVICE_NAME}"
